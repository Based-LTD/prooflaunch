# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# … but .env.example IS committed so self-hosters know which vars are required
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Solana vanity keypair files — PRIVATE KEYS, never commit
vanity-pool/
*.json.keypair

# Local-only admin ops tool (drains burners) — never commit
tools/recover-meme.mjs
tools/migrate-proof-to-pool.mjs

# Meteora DBC config keypair stashes — contain private keys; never commit.
# Created by tools/meteora-create-config.mjs after a successful config init.
meteora-dbc-config.*.json
meteora-dbc-config-usdc.*.json
meteora-mainnet-test.*.json
meteora-distribute-test.*.json
meteora-prod-e2e.*.json
# E2E test keypair files written by tools/usdc-mainnet-e2e.mjs and similar.
# These contain raw base58 secret keys for temporary test wallets — sweep
# the wallets and delete the file when done; NEVER commit.
usdc-e2e-keys.*.json
*-e2e-keys.*.json
usdc-bot-key.*.json
*-bot-key.*.json
