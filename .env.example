# ============================================================================
# Proof Launch — environment variables
# ----------------------------------------------------------------------------
# Copy this file to .env.local and fill in your own values. The repo ships
# no real secrets; every variable below is a placeholder. Required for all
# environments (local + production) unless noted otherwise.
# ============================================================================

# --- Supabase (database) -----------------------------------------------------
# Create a project at https://supabase.com; service role key is the SECRET one
# from Settings → API. The anon key is safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Solana RPC --------------------------------------------------------------
# Public mainnet-beta is rate-limited; use Helius / QuickNode / Triton for
# anything beyond local dev. The network value must match the RPC.
NEXT_PUBLIC_SOLANA_RPC_URL=https://your-rpc-provider.example.com
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# --- Platform-controlled wallets ---------------------------------------------
# ESCROW_WALLET_PRIVATE_KEY is a bs58-encoded Solana secret key. This wallet
# pays for transaction fees, signs claim payouts, and holds platform fee
# revenue. PLATFORM_WALLET_ADDRESS is the public destination for the 10%
# platform cut after fee distribution.
ESCROW_WALLET_PRIVATE_KEY=your-bs58-encoded-escrow-private-key
PLATFORM_WALLET_ADDRESS=your-platform-wallet-public-address

# --- Burner / pool / sub-escrow key encryption -------------------------------
# AES-256-GCM symmetric key used to encrypt per-meme pool wallet private keys
# and per-meme sub-escrow wallet private keys at rest in Supabase. SHOULD be
# a long high-entropy random string (>= 32 bytes worth). NEVER rotate without
# re-encrypting existing rows — losing this key means losing access to every
# pool and sub-escrow wallet.
BURNER_ENCRYPTION_KEY=your-long-random-encryption-secret

# --- Cron auth ---------------------------------------------------------------
# Shared secret used by Vercel cron requests to authorize /api/process-memes,
# /api/reconcile, /api/fees/process, and /api/health/drift. Vercel sends
# `Authorization: Bearer <CRON_SECRET>` when this env var is set on the
# Vercel project. Required in production; optional locally (routes skip the
# auth check when CRON_SECRET is unset).
CRON_SECRET=your-cron-shared-secret
